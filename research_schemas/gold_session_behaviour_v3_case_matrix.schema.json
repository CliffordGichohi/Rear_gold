    "fact": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "epistemic_status": {
                "const": "UNKNOWN"
              }
            },
            "required": [
              "epistemic_status"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "epistemic_status": {
                "const": "INFERRED"
              }
            },
            "required": [
              "epistemic_status"
            ]
          },
          "then": {
            "properties": {
              "explanation": {
                "minLength": 1
              }
            }
          }
        }
      ],
