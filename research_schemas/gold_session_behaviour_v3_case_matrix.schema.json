{
  "$id": "https://gold-intel.local/schemas/gold_session_behaviour_v3_case_matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One immutable, point-in-time-correct London or New York gold session case. Decision-known conditions and neutral subsequent behaviour are strictly separated. This schema contains no trade direction, entry, stop, target, MFE, MAE, P&L, reward-to-risk, or position sizing.",
  "properties": {
    "case_metadata": {
      "$ref": "#/$defs/case_metadata"
    },
    "decision_state": {
      "$ref": "#/$defs/decision_state"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "quality": {
      "$ref": "#/$defs/case_quality"
    },
    "research_policy": {
      "$ref": "#/$defs/research_policy"
    },
    "subsequent_behaviour": {
      "$ref": "#/$defs/subsequent_behaviour"
    }
  },
  "required": [
    "case_metadata",
    "lineage",
    "decision_state",
    "subsequent_behaviour",
    "quality",
    "research_policy"
  ],
  "title": "Gold Session Behaviour V3 Case Matrix Row",
  "type": "object",
  "$defs": {
    "case_metadata": {
      "additionalProperties": false,
      "properties": {
        "access_class": {
          "enum": [
            "DEVELOPMENT",
            "EXPOSED_HISTORICAL_FORWARD_TEST",
            "LOCKED_INDEPENDENT_HOLDOUT",
            "PROSPECTIVE"
          ]
        },
        "case_id": {
          "minLength": 1,
          "type": "string"
        },
        "case_revision": {
          "minimum": 1,
          "type": "integer"
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "data_partition": {
          "enum": [
            "DEVELOPMENT_2021_2024",
            "EXPOSED_2025",
            "LOCKED_2026_YTD",
            "PROSPECTIVE_2026"
          ]
        },
        "decision_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observation_end": {
          "$ref": "#/$defs/timestamp"
        },
        "observation_start": {
          "$ref": "#/$defs/timestamp"
        },
        "record_hash": {
          "$ref": "#/$defs/sha256"
        },
        "schema_version": {
          "const": "gold-session-behaviour-v3-case-matrix-0.1.0"
        },
        "sealed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "session_code": {
          "enum": [
            "LONDON",
            "NEW_YORK"
          ]
        },
        "session_date": {
          "format": "date",
          "type": "string"
        },
        "session_timezone": {
          "enum": [
            "Europe/London",
            "America/New_York"
          ]
        }
      },
      "required": [
        "case_id",
        "schema_version",
        "case_revision",
        "session_code",
        "session_date",
        "session_timezone",
        "decision_at",
        "observation_start",
        "observation_end",
        "data_partition",
        "access_class",
        "created_at",
        "sealed_at",
        "record_hash"
      ],
      "type": "object"
    },
    "case_quality": {
      "additionalProperties": false,
      "properties": {
        "decision_state_point_in_time_valid": {
          "type": "boolean"
        },
        "duplicate_key_check_passed": {
          "type": "boolean"
        },
        "dst_check_passed": {
          "type": "boolean"
        },
        "issue_codes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "one_minute_source_complete": {
          "type": "boolean"
        },
        "outcome_separation_check_passed": {
          "type": "boolean"
        },
        "overall_state": {
          "enum": [
            "VALID",
            "PARTIAL",
            "INVALID"
          ]
        },
        "session_path_complete": {
          "type": "boolean"
        },
        "unknown_field_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
