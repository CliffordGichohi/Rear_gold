# Gold Market Intelligence Engine - example configuration
# Copy this file to .env, then paste the cTrader Open API application credentials.
# Never store your IC Markets/cTrader email or password here.

APP_ENV=development

POSTGRES_DB=gold_intel
POSTGRES_USER=gold_intel
POSTGRES_PASSWORD=gold_intel_dev
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://gold_intel:gold_intel_dev@postgres:5432/gold_intel
REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0
RAW_STORE_PATH=/app/data/raw
BLIND_REPLAY_ARTIFACT_PATH=/app/research_artifacts/gold_blind_discretionary_replay_v1
BLIND_REPLAY_V2_ARTIFACT_PATH=/app/research_artifacts/gold_blind_synchronized_setup_replay_v2
BLIND_REPLAY_V3_ARTIFACT_PATH=/app/research_artifacts/gold_annotated_replay_v3
BLIND_REPLAY_V3_LEDGER_PATH=/app/research_artifacts/gold_annotated_replay_v3/ledgers/practice_event_ledger_v3.jsonl
CODEX_OPERATOR_REPLAY_ARTIFACT_PATH=/app/research_artifacts/gold_blind_codex_operator_replay_v1
CODEX_OPERATOR_REPLAY_VISIBLE_LEDGER_PATH=/app/research_artifacts/gold_blind_codex_operator_replay_v1/ledgers/codex_blind_visible_ledger.jsonl
CODEX_OPERATOR_REPLAY_OUTCOME_LEDGER_PATH=/app/research_artifacts/gold_blind_codex_operator_replay_v1/outcome_vault/codex_blind_outcome_ledger.jsonl
MATCHED_HUMAN_REPLAY_ARTIFACT_PATH=/app/research_artifacts/gold_matched_human_replay_v1
MATCHED_HUMAN_REPLAY_VISIBLE_LEDGER_PATH=/app/research_artifacts/gold_matched_human_replay_v1/ledgers/matched_human_visible_ledger.jsonl
MATCHED_HUMAN_REPLAY_OUTCOME_LEDGER_PATH=/app/research_artifacts/gold_matched_human_replay_v1/outcome_vault/matched_human_outcome_ledger.jsonl
API_CORS_ORIGINS=["http://localhost:3000"]
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ENVIRONMENT=demo
CTRADER_SCOPE=accounts
CTRADER_REDIRECT_URI=http://localhost:8000/api/v1/providers/ctrader/oauth/callback
CTRADER_ACCOUNT_ID=
# Required in production. In local development only, the cTrader client secret
# is used as fallback key material so OAuth tokens are never stored in plaintext.
PROVIDER_TOKEN_ENCRYPTION_KEY=
OAUTH_STATE_TTL_SECONDS=300

# Optional official adapters. The ALFRED vintage sync requires a free FRED key.
# BLS/BEA keys are reserved for direct-source verification adapters.
FRED_API_KEY=
BLS_REGISTRATION_KEY=
BEA_API_KEY=

# Optional licensed exchange history. Databento historical CME data is
# usage-based; the key must remain in the gitignored root .env.
DATABENTO_API_KEY=

# Licensed point-in-time expectations. Trading Economics supplies calendar
# consensus/releases; CME FedWatch EOD supplies complete meeting probabilities.
TRADING_ECONOMICS_API_KEY=
CME_FEDWATCH_CLIENT_ID=
CME_FEDWATCH_CLIENT_SECRET=
